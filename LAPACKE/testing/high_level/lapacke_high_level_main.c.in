/*****************************************************************************
* Test runner for the dedicated high-level LAPACKE tests, one precision.
*
* Generated by CMake from high_level/lapacke_high_level_main.c.in -- do not edit.
* The test table is derived from the LAPACKE_HIGH_LEVEL_ROUTINES list in
* LAPACKE/testing/high_level/CMakeLists.txt, once per precision.
*
* Usage: @LAPACKE_HIGH_LEVEL_PROGRAM@ [test-name]
* Runs all registered tests, or only the named one. Exit code is the number
* of failed checks, clamped to 125 so that a large count cannot wrap around
* to a passing 0 in the 8-bit exit status.
*****************************************************************************/

#include <stdio.h>
#include <string.h>

#include "lapacke_test.h"

@LAPACKE_HIGH_LEVEL_EXTERNS@
static const struct {
    const char* name;
    void (*fn)(void);
} lapacke_high_level_tests[] = {
@LAPACKE_HIGH_LEVEL_ENTRIES@};

static char saved_name[32] = { '\0' };
static lapack_int saved_info = 0;
void LAPACKE_xer_replace LAPACKE_XERBLA_ARGS
{
    strncpy(saved_name, name, sizeof(saved_name)-1);
    saved_name[sizeof(saved_name)-1] = '\0';
    saved_info = -info; /* LAPACKE_xerbla is called with negative numbers even though Fortran calls with positive */
}

int main(int argc, char** argv)
{
    const size_t test_count = 1 +
        sizeof(lapacke_high_level_tests) / sizeof(lapacke_high_level_tests[0]);
    size_t i;
    int matched = 0;
    lapack_int minus_1 = -1, two = 2, one = 1, info = 0;
    LAPACK_XERBLA F77_cb;
    LAPACK_get_lapack_xerbla(&F77_cb);
    LAPACK_set_lapack_xerbla(F77_cb);
    API_SUFFIX(LAPACKE_set_xerbla)(LAPACKE_xer_replace, NULL);
    LAPACK_sgesv(&minus_1, &minus_1, NULL, &minus_1, NULL, NULL, &minus_1, &info);
    if (saved_info != 1 || strncmp("SGESV", saved_name, 5) != 0) {
        lapacke_test_failures++;
        if (saved_info != 1)
            fprintf(stderr, "LAPACKE_xerbla override failed: saved_info=%d\n", (int)saved_info);
        else
            fprintf(stderr, "LAPACKE_xerbla override failed: name='%s'\n", saved_name);
    }
    API_SUFFIX(LAPACKE_set_xerbla)(NULL, NULL);

    /* Route LAPACKE-internal allocations through the counting/failing test
     * allocator; everything else tests the stock LAPACKE library. */
    LAPACKE_set_alloc(lapacke_test_malloc, lapacke_test_free);

    for (i = 0; i < test_count-1; i++) {
        if (argc > 1 && strcmp(argv[1], lapacke_high_level_tests[i].name) != 0) {
            continue;
        }
        matched++;
        printf("== %s\n", lapacke_high_level_tests[i].name);
        lapacke_high_level_tests[i].fn();
        lapacke_test_check_leaks(lapacke_high_level_tests[i].name);
    }

    if (argc > 1 && matched == 0) {
        fprintf(stderr, "unknown test '%s'; available tests:\n", argv[1]);
        for (i = 0; i < test_count-1; i++) {
            fprintf(stderr, "  %s\n", lapacke_high_level_tests[i].name);
        }
        return 1;
    }

    printf("%d checks, %d failures\n", lapacke_test_checks + 1,
           lapacke_test_failures);
    return lapacke_test_failures > 125 ? 125 : lapacke_test_failures;
}
