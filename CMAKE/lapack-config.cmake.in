@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT @BUILD_SHARED_LIBS@)
  block(PROPAGATE ${CMAKE_FIND_PACKAGE_NAME}_FOUND
        ${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE)
  set(BLA_SIZEOF_INTEGER @lapack_integer_size@)
  if(@lapack_external_blas@)
    find_dependency(BLAS MODULE)
  else()
    find_dependency(
      @BLASLIB@
      @LAPACK_VERSION@
      EXACT
      CONFIG
      HINTS
      "${CMAKE_CURRENT_LIST_DIR}"
      "${CMAKE_CURRENT_LIST_DIR}/../@BLASLIB@")
  endif()
  if(@USE_XBLAS@ AND NOT TARGET LAPACK::XBLAS)
    find_library(XBLAS_LIBRARY NAMES xblas)
    if(NOT XBLAS_LIBRARY)
      set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
      set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
          "XBLAS is required by @LAPACKLIB@")
      return()
    endif()
    add_library(LAPACK::XBLAS UNKNOWN IMPORTED)
    set_target_properties(LAPACK::XBLAS PROPERTIES IMPORTED_LOCATION
                                                   "${XBLAS_LIBRARY}")
  endif()
  endblock()
endif()

if(NOT TARGET LAPACK::@LAPACKLIB@)
  include("${CMAKE_CURRENT_LIST_DIR}/@LAPACKLIB@-targets.cmake")
endif()
if(NOT TARGET LAPACK::LAPACK)
  add_library(LAPACK::LAPACK ALIAS LAPACK::@LAPACKLIB@)
endif()
set(LAPACK_LIBRARIES LAPACK::@LAPACKLIB@)
get_target_property(LAPACK_INCLUDE_DIRS LAPACK::@LAPACKLIB@
                    INTERFACE_INCLUDE_DIRECTORIES)
set(LAPACK_Fortran_COMPILER_ID "@CMAKE_Fortran_COMPILER_ID@")
check_required_components(${CMAKE_FIND_PACKAGE_NAME})
