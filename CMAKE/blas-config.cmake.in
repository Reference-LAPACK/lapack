@PACKAGE_INIT@

if(NOT TARGET BLAS::@BLASLIB@)
  include("${CMAKE_CURRENT_LIST_DIR}/@BLASLIB@-targets.cmake")
endif()
if(NOT TARGET BLAS::BLAS)
  add_library(BLAS::BLAS ALIAS BLAS::@BLASLIB@)
endif()
set(BLAS_LIBRARIES BLAS::@BLASLIB@)
get_target_property(BLAS_INCLUDE_DIRS BLAS::@BLASLIB@ INTERFACE_INCLUDE_DIRECTORIES)
set(BLAS_Fortran_COMPILER_ID "@CMAKE_Fortran_COMPILER_ID@")
check_required_components(${CMAKE_FIND_PACKAGE_NAME})
